# Names this deployment on its public Privacy Policy / Terms of Service pages
# (src/operator.ts) - Google's OAuth consent screen review requires those pages
# be clearly linked to a real app/organization, not read as a generic template.
# Override (or delete this file) for a different deployment; the pages fall
# back to generic wording when these are unset.
VITE_OPERATOR_LABEL="the operator of lexis.neointellect.com"
VITE_OPERATOR_CONTACT_URL="https://github.com/PuspenduBanerjee/Lexis/issues"
